+class ScpiPage(MarketPage):
+    """Compte SCPI : solde et numéro comme un compte titres, parts lues dans « Positions »."""
+
+    @method
+    class iter_investment(TableElement):
+        item_xpath = '//table[.//th[contains(., "Nombre total de parts")]]/tbody/tr'
+        head_xpath = '//table[.//th[contains(., "Nombre total de parts")]]/thead/tr/th'
+
+        col_label = "SCPI"
+        col_quantity = "Nombre total de parts"
+        col_valuation = re.compile(r"^Valorisation totale")
+
+        class item(ItemElement):
+            klass = Investment
+
+            obj_label = Base(TableCell("label"), CleanText('.//span[contains(@class, "c-link__label")]'))
+            obj_code = Base(
+                TableCell("label"), CleanText('.//span[contains(@class, "c-table__mention")]', default=NotAvailable)
+            )
+            obj_quantity = CleanDecimal.French(TableCell("quantity"))
+            # Valeur de retrait, d'après la note du tableau.
+            obj_valuation = CleanDecimal.French(TableCell("valuation"))
+
+            def obj_unitvalue(self):
+                quantity = Field("quantity")(self)
+                if not quantity:
+                    return NotAvailable
+                # Sans arrondi : parts × valeur doit redonner la valorisation lue.
+                return Field("valuation")(self) / quantity
+
